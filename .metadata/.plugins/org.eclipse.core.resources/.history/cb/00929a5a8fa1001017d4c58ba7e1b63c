This program will gather data from the JavaBean and display it. --%>

<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="beans.FavBookBean" %>

<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>Favorite Books (Using JavaBean)</title>
	<link rel="stylesheet" type="text/css" href="styles.css">
</head>

<body>
	<h1>My Favorite Books (Module 4)</h1>
	<p>This table shows my top 5 favorite books using a JavaBean object.</p>

	<%-- Create FavBookBean objects and store them in an array --%>
	<%
		FavBookBean[] books = {
			new FavBookBean("The Comfort Book", "Matt Haig", "Self-help"),
			new FavBookBean("The Let Them Theory", "Mel Robbins", "Self-help"),
			new FavBookBean("Demon Slayer: Kimetsu no Yaiba", "Koyoharu Gotouge", "Manga"),
			new FavBookBean("Twilight", "Stephenie Meyer", "Young Adult"),
			new FavBookBean("Clarity & Connection", "Yung Pueblo", "Poetry")
		};
	%>

	<table>
		<tr>
			<th>Title</th>
			<th>Author</th>
			<th>Genre</th>
		</tr>

		<%-- Loop through Bean array and print each record --%>
		<%
			for (FavBookBean book : books) {
		%>
			<tr>
				<td><%= book.getTitle() %></td>
				<td><%= book.getAuthor() %></td>
				<td><%= book.getGenre() %></td>
			</tr>
		<%
			}
		%>
	</table>
</body>
</html>

